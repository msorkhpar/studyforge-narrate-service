{
  "consuming_api": 1,
  "provides": 2,
  "component": "narrate-service",
  "not_yet_declared": [
    "voices"
  ],
  "service": {
    "image": "narrate-service:local",
    "built_from": "Dockerfile",
    "ports": [
      {
        "container": 8870,
        "host_bind": "127.0.0.1",
        "protocol": "tcp",
        "purpose": "the HTTP API",
        "publish_on_all_interfaces": false
      }
    ],
    "healthcheck": {
      "path": "/healthz",
      "port": 8870,
      "expect_status": 200,
      "start_period_seconds": 10,
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "retries": 3
    },
    "mounts": [
      {
        "container_path": "/var/lib/narrate/artifacts",
        "kind": "volume",
        "read_only": false,
        "required": true,
        "purpose": "the artifact store: one audio file and one small JSON record per content address. It is not garbage-collected"
      }
    ],
    "runs_as": {
      "uid": 10001,
      "user": "narrate"
    },
    "docker_socket": false,
    "environment": [
      {
        "name": "NARRATE_ENGINE",
        "default": "kokoro",
        "required": false,
        "one_of": [
          "kokoro"
        ]
      },
      {
        "name": "NARRATE_ENGINE_URL",
        "default": "http://127.0.0.1:8880/v1",
        "required": true,
        "note": "the engine's address inside the deployment's own network"
      },
      {
        "name": "NARRATE_ENGINE_PROFILE",
        "default": "unknown",
        "required": false,
        "one_of": [
          "cpu",
          "gpu",
          "unknown"
        ],
        "note": "declared by the deployment, never detected by the service"
      },
      {
        "name": "NARRATE_BIND",
        "default": "127.0.0.1",
        "required": false,
        "note": "0.0.0.0 inside the container only; the host binding is the ports entry"
      },
      {
        "name": "NARRATE_PORT",
        "default": "8870",
        "required": false
      },
      {
        "name": "NARRATE_ARTIFACT_DIR",
        "default": "artifacts",
        "required": false,
        "note": "set to the mount's container_path in the image"
      },
      {
        "name": "NARRATE_VOICE",
        "default": "am_liam",
        "required": false
      },
      {
        "name": "NARRATE_CHUNK_CHARS",
        "default": "1800",
        "required": false
      },
      {
        "name": "NARRATE_TIMEOUT_SECONDS",
        "default": "600",
        "required": false,
        "note": "per chunk; sized for the cpu profile, which is the slow one"
      }
    ]
  },
  "profiles": {
    "default": "cpu",
    "cpu": {
      "opt_in": null,
      "compose_files": [
        "compose.yaml"
      ],
      "engine_image": "ghcr.io/remsky/kokoro-fastapi-cpu:v0.8.2@sha256:8545e2a4ae8d040749a369a848236fcf768aabc3b5b7a89451afa6507101c59a",
      "requires": {
        "gpu": false,
        "vendor_runtime": null,
        "host_driver": null,
        "devices": []
      },
      "engine_published": false
    },
    "gpu": {
      "opt_in": "-f compose.yaml -f compose.gpu.yaml",
      "compose_files": [
        "compose.yaml",
        "compose.gpu.yaml"
      ],
      "engine_image": "ghcr.io/remsky/kokoro-fastapi-gpu:v0.8.2-cu128-amd64@sha256:a95e53e3ed3da1c73ca7a36e4608c451f19117205d28252bad1f4c07062ec387",
      "requires": {
        "gpu": true,
        "vendor_runtime": "nvidia-container-toolkit",
        "host_driver": "nvidia",
        "devices": [
          {
            "driver": "nvidia",
            "count": "all",
            "capabilities": [
              "gpu"
            ]
          }
        ]
      },
      "engine_published": false
    }
  },
  "api": {
    "base_path": "/v1",
    "routes": [
      {
        "method": "GET",
        "path": "/healthz",
        "response": "application/json"
      },
      {
        "method": "POST",
        "path": "/v1/speech",
        "request": "application/json",
        "response": "audio/mpeg"
      },
      {
        "method": "POST",
        "path": "/v1/jobs",
        "request": "application/json",
        "response": "application/json",
        "note": "a batch of {id, text} segments in, a manifest out. Never audio: fetch each artifact by its address"
      },
      {
        "method": "GET",
        "path": "/v1/artifacts/{id}",
        "response": "audio/mpeg"
      }
    ],
    "formats": [
      "mp3"
    ],
    "max_request_bytes": 4194304,
    "engine_reported_on": [
      "/healthz",
      "POST /v1/speech",
      "POST /v1/jobs"
    ],
    "engine_headers": [
      "Narrate-Engine",
      "Narrate-Engine-Model",
      "Narrate-Cached"
    ],
    "manifest": {
      "versioned_by": "provides",
      "one_entry_per_submitted_id": true,
      "http_status_for_a_well_formed_job": 200,
      "segment_statuses": [
        "synthesised",
        "cached",
        "failed",
        "skipped"
      ],
      "failure_reasons": [
        "engine_unavailable",
        "engine_failed",
        "not_synthesisable"
      ],
      "halts_the_job": [
        "engine_unavailable"
      ],
      "max_segments": 5000
    },
    "cache": {
      "content_addressed": true,
      "idempotent": true,
      "scheme": "narrate-address-2",
      "hash": "sha256",
      "over": [
        "format",
        "voice",
        "chunk_chars",
        "text"
      ],
      "encoding": "utf-8, each field length-prefixed as '<bytes>:' before the bytes; chunk_chars as its decimal digits",
      "order": [
        "narrate-address-2",
        "format",
        "voice",
        "chunk_chars",
        "text"
      ],
      "engine_in_address": false,
      "note": "the engine PROFILE is deliberately not in the address, so moving between the cpu and gpu builds of one model does not re-synthesise a corpus; a cached artifact reports the engine that actually made it. WARNING: that argument does not cover a MODEL change, which is audio-changing and is also outside the address -- swapping the model keeps every address and serves different audio. Open, routed to the voice-catalogue task. chunk_chars IS in the address because it decides where the text is cut and each chunk is a separate engine request, so a different budget is different bytes at every join; its value for this deployment is published on GET /healthz and in every manifest",
      "chunk_chars_is_a_deployment_setting": true,
      "engine_model_in_address": false
    },
    "caller_obligations": [
      "gate personal data out of the text before the request; this service never inspects it",
      "place artifacts yourself; this service never writes into a caller's tree",
      "read the manifest's counts: a well-formed job answers 200 whatever its segments did"
    ]
  }
}
