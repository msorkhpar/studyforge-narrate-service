{
  "consuming_api": 1,
  "provides": 3,
  "component": "narrate-service",
  "not_yet_declared": [],
  "service": {
    "image": "narrate-service:local",
    "built_from": "Dockerfile",
    "ports": [
      {
        "container": 8870,
        "host_bind": "127.0.0.1",
        "protocol": "tcp",
        "purpose": "the HTTP API",
        "publish_on_all_interfaces": false
      }
    ],
    "healthcheck": {
      "path": "/healthz",
      "port": 8870,
      "expect_status": 200,
      "start_period_seconds": 10,
      "interval_seconds": 60,
      "timeout_seconds": 10,
      "retries": 3
    },
    "mounts": [
      {
        "container_path": "/var/lib/narrate/artifacts",
        "kind": "volume",
        "read_only": false,
        "required": true,
        "purpose": "the artifact store: one audio file and one small JSON record per content address. It is not garbage-collected"
      }
    ],
    "runs_as": {
      "uid": 10001,
      "user": "narrate"
    },
    "docker_socket": false,
    "environment": [
      {
        "name": "NARRATE_ENGINE",
        "default": "kokoro",
        "required": false,
        "one_of": [
          "kokoro"
        ]
      },
      {
        "name": "NARRATE_ENGINE_URL",
        "default": "http://127.0.0.1:8880/v1",
        "required": true,
        "note": "the engine's address inside the deployment's own network"
      },
      {
        "name": "NARRATE_ENGINE_PROFILE",
        "default": "unknown",
        "required": false,
        "one_of": [
          "cpu",
          "gpu",
          "unknown"
        ],
        "note": "declared by the deployment, never detected by the service"
      },
      {
        "name": "NARRATE_BIND",
        "default": "127.0.0.1",
        "required": false,
        "note": "0.0.0.0 inside the container only; the host binding is the ports entry"
      },
      {
        "name": "NARRATE_PORT",
        "default": "8870",
        "required": false
      },
      {
        "name": "NARRATE_ARTIFACT_DIR",
        "default": "artifacts",
        "required": false,
        "note": "set to the mount's container_path in the image"
      },
      {
        "name": "NARRATE_VOICE",
        "default": "am_liam",
        "required": false
      },
      {
        "name": "NARRATE_CHUNK_CHARS",
        "default": "1800",
        "required": false
      },
      {
        "name": "NARRATE_TIMEOUT_SECONDS",
        "default": "600",
        "required": false,
        "note": "per chunk; sized for the cpu profile, which is the slow one"
      }
    ]
  },
  "agent": {
    "optional": true,
    "purpose": "an agent-callable adapter for one-off narration outside a corpus build",
    "command": ["python3", "-m", "narrate", "agent"],
    "transport": "stdio, newline-delimited JSON-RPC 2.0 -- one compact JSON object per line. NOT the LSP-style Content-Length header framing",
    "tools": ["synthesize", "narrate_batch", "voices"],
    "started_by_any_compose_profile": false,
    "in_the_container_command": false,
    "reads_the_same_environment_as_serve": true,
    "shares_the_store": false,
    "shares_the_store_note": "by default the adapter and a deployment do NOT share an artifact directory: the container sets NARRATE_ARTIFACT_DIR to its volume mount and the adapter on a host takes the relative default. Pointing them at one directory makes the adapter a SECOND WRITING PROCESS, and the store publish lock is in-process -- two processes racing one address can publish one synthesis audio beside the other record. Both halves stay complete and valid; only the byte count and duration would belong to the twin",
    "gate": "the personal-data gate is the CALLER's and there is no framework client between an agent and the engine here. Every tool description states it",
    "documented_in": "docs/agent.md"
  },
  "profiles": {
    "default": "cpu",
    "cpu": {
      "opt_in": null,
      "compose_files": [
        "compose.yaml"
      ],
      "engine_image": "ghcr.io/remsky/kokoro-fastapi-cpu:v0.8.2@sha256:8545e2a4ae8d040749a369a848236fcf768aabc3b5b7a89451afa6507101c59a",
      "requires": {
        "gpu": false,
        "vendor_runtime": null,
        "host_driver": null,
        "devices": []
      },
      "engine_published": false
    },
    "gpu": {
      "opt_in": "-f compose.yaml -f compose.gpu.yaml",
      "compose_files": [
        "compose.yaml",
        "compose.gpu.yaml"
      ],
      "engine_image": "ghcr.io/remsky/kokoro-fastapi-gpu:v0.8.2-cu128-amd64@sha256:a95e53e3ed3da1c73ca7a36e4608c451f19117205d28252bad1f4c07062ec387",
      "requires": {
        "gpu": true,
        "vendor_runtime": "nvidia-container-toolkit",
        "host_driver": "nvidia",
        "devices": [
          {
            "driver": "nvidia",
            "count": "all",
            "capabilities": [
              "gpu"
            ]
          }
        ]
      },
      "engine_published": false
    }
  },
  "api": {
    "base_path": "/v1",
    "routes": [
      {
        "method": "GET",
        "path": "/healthz",
        "response": "application/json"
      },
      {
        "method": "GET",
        "path": "/v1/voices",
        "response": "application/json",
        "note": "the voice catalogue and this deployment default voice. Answers identically whether the engine is up or down: the catalogue is declared by the engine adapter, never fetched"
      },
      {
        "method": "POST",
        "path": "/v1/speech",
        "request": "application/json",
        "response": "audio/mpeg"
      },
      {
        "method": "POST",
        "path": "/v1/jobs",
        "request": "application/json",
        "response": "application/json",
        "note": "a batch of {id, text} segments in, a manifest out. Never audio: fetch each artifact by its address"
      },
      {
        "method": "GET",
        "path": "/v1/artifacts/{id}",
        "response": "audio/mpeg"
      }
    ],
    "formats": [
      "mp3"
    ],
    "max_request_bytes": 4194304,
    "address_bearing_settings": {
      "fields": [
        "chunk_chars",
        "engine_model"
      ],
      "published_on": [
        "GET /healthz",
        "the addressing block of every manifest"
      ],
      "note": "deployment settings that are part of the content address. A caller that recomputes an address must read them from one of those two places"
    },
    "engine_reported_on": [
      "/healthz",
      "POST /v1/speech",
      "POST /v1/jobs"
    ],
    "engine_headers": [
      "Narrate-Engine",
      "Narrate-Engine-Model",
      "Narrate-Cached"
    ],
    "manifest": {
      "versioned_by": "provides",
      "one_entry_per_submitted_id": true,
      "http_status_for_a_well_formed_job": 200,
      "segment_statuses": [
        "synthesised",
        "cached",
        "failed",
        "skipped"
      ],
      "failure_reasons": [
        "engine_unavailable",
        "engine_failed",
        "not_synthesisable"
      ],
      "halts_the_job": [
        "engine_unavailable"
      ],
      "max_segments": 5000
    },
    "cache": {
      "content_addressed": true,
      "idempotent": true,
      "scheme": "narrate-address-3",
      "hash": "sha256",
      "over": [
        "format",
        "voice",
        "chunk_chars",
        "engine_model",
        "text"
      ],
      "encoding": "utf-8, each field length-prefixed as '<bytes>:' before the bytes; chunk_chars as its decimal digits",
      "order": [
        "narrate-address-3",
        "format",
        "voice",
        "chunk_chars",
        "engine_model",
        "text"
      ],
      "engine_in_address": false,
      "note": "the engine FAMILY and the hardware PROFILE are deliberately not in the address, so moving between the cpu and gpu builds of one model does not re-synthesise a corpus, and a cached artifact reports the engine that actually made it. The engine MODEL is IN the address as of narrate-address-3 (NS-04, closing CTO-69/19): it decides how a voice sounds, and while it was outside, swapping the model kept every address and served different audio. chunk_chars is in the address because it decides where the text is cut and each chunk is a separate engine request, so a different budget is different bytes at every join. Both chunk_chars and engine_model are DEPLOYMENT settings: their values for this deployment are published on GET /healthz and in the addressing block of every manifest, so a caller recomputing an address reads them there and never from a constant",
      "chunk_chars_is_a_deployment_setting": true,
      "engine_model_in_address": true
    },
    "caller_obligations": [
      "gate personal data out of the text before the request; this service never inspects it",
      "place artifacts yourself; this service never writes into a caller's tree",
      "read the manifest's counts: a well-formed job answers 200 whatever its segments did",
      "pick a voice from the voices block or from GET /v1/voices: an unknown id is a 400 for the whole request, never a silent default"
    ]
  },
  "voices": {
    "engine": "kokoro",
    "default": "am_liam",
    "count": 68,
    "route": "GET /v1/voices",
    "selection": "per request, the optional voice key on POST /v1/speech and on POST /v1/jobs; per deployment, NARRATE_VOICE, which is the value used when a request names none",
    "unknown_voice": "refused with HTTP 400 naming what is permitted. For a job it refuses the WHOLE job before any segment is attempted. Never silently defaulted",
    "in_the_content_address": true,
    "declared_not_fetched": true,
    "measured_from": {
      "route": "GET /v1/audio/voices",
      "engine_image": "ghcr.io/remsky/kokoro-fastapi-cpu:v0.8.2@sha256:8545e2a4ae8d040749a369a848236fcf768aabc3b5b7a89451afa6507101c59a",
      "profile": "cpu",
      "note": "the ids are a reading taken from that image. The name, language and gender of each are DERIVED from the id by the rule published in narrate/engine/kokoro.py and are not measured. The gpu image is the same upstream version and was NOT read; reconcile any running engine with python3 -m tools.reconcile_voices <engine-base-url>"
    },
